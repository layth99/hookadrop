# ─── REQUIRED for production (Netlify) ───────────────────────────────────────
# Replace with your deployed backend URL (e.g. Render, Railway, Heroku)
VITE_API_URL=https://your-backend-url.onrender.com/api

# ─── Local development ────────────────────────────────────────────────────────
# Leave empty locally — Vite proxy handles /api → http://localhost:8000
# VITE_API_URL=
