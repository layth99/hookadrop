<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fitsSystemWindows="true">

    <!-- SMOKE BACKGROUND: Bottom-most layer with Screen blend mode -->
    <com.hookahdrop.app.view.SmokeBackgroundView
        android:id="@+id/smokeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AURA: Soft radial glow behind hookah (DEFECT A FIX) -->
    <com.hookahdrop.app.view.AuraView
        android:id="@+id/auraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Background Orbs Layer (DEFECT A FIX: soft gradients, no blur) -->
    <com.hookahdrop.app.view.OrbView
        android:id="@+id/orbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Smoke Particle System (above orbs, below scrim) -->
    <com.hookahdrop.app.view.SmokeParticleView
        android:id="@+id/smokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BOTTOM SCRIM (DEFECT B FIX): Full-screen overlay, lower 56%, gradient from transparent -->
    <com.hookahdrop.app.view.BottomScrimView
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Content - FIXED LAYOUT: Column structure with weight(1f) for hookah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Wordmark -->
        <TextView
            android:id="@+id/tvWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOOKADROP"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.26"
            android:alpha="0"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- HOOKAH AREA: Takes all leftover height with weight=1 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Hookah Custom View - centered, top-aligned, fills height with aspect ratio -->
            <com.hookahdrop.app.view.HookahView
                android:id="@+id/hookahView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal|top"
                android:alpha="0"
                android:contentDescription="Premium hookah" />

        </FrameLayout>

        <!-- TEXT BLOCK: Always visible, wrap content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Eyebrow Layout -->
            <LinearLayout
                android:id="@+id/layoutEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|center_horizontal"
                android:alpha="0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="34dp"
                    android:layout_height="1dp"
                    android:background="@android:drawable/dialog_holo_dark_frame" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREMIUM HOOKAH EXPERIENCE"
                    android:textSize="10sp"
                    android:letterSpacing="0.26"
                    android:textColor="#9AA1A9"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="1dp"
                    android:background="@android:drawable/dialog_holo_dark_frame" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The experience you've\nbeen waiting\nfor"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:lineSpacingMultiplier="1.12"
                android:letterSpacing="-0.02"
                android:alpha="0"
                android:layout_marginBottom="8dp" />

            <!-- Lead Text -->
            <TextView
                android:id="@+id/tvLead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy or rent your favorite hookah with fast home delivery."
                android:textSize="13sp"
                android:textColor="#9AA1A9"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:maxWidth="300dp"
                android:alpha="0"
                android:layout_marginBottom="16dp" />

            <!-- Services Row with FIXED HEIGHT to prevent divider overflow -->
            <LinearLayout
                android:id="@+id/layoutServices"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:alpha="0"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="-8dp"
                android:layout_marginBottom="20dp">

                <!-- Service 1: Fast Delivery -->
                <LinearLayout
                    android:id="@+id/layoutService1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:id="@+id/viewServiceCircle1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_service_circle" />

                        <ImageView
                            android:id="@+id/ivServiceIcon1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_in_transit"
                            android:scaleType="fitCenter"
                            android:contentDescription="Fast Delivery" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvService1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast Delivery"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvService1Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To your door"
                        android:textSize="10.5sp"
                        android:textColor="#9AA1A9"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Divider 1 - FIXED HEIGHT with padding -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#30FFFFFF"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Service 2: Premium Products -->
                <LinearLayout
                    android:id="@+id/layoutService2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:id="@+id/viewServiceCircle2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_service_circle" />

                        <ImageView
                            android:id="@+id/ivServiceIcon2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_diamond"
                            android:scaleType="fitCenter"
                            android:contentDescription="Premium Products" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvService2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium Products"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvService2Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% Authentic"
                        android:textSize="10.5sp"
                        android:textColor="#9AA1A9"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Divider 2 - FIXED HEIGHT with padding -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#30FFFFFF"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Service 3: 24/7 Support -->
                <LinearLayout
                    android:id="@+id/layoutService3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:id="@+id/viewServiceCircle3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_service_circle" />

                        <ImageView
                            android:id="@+id/ivServiceIcon3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_headset"
                            android:scaleType="fitCenter"
                            android:contentDescription="24/7 Support" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvService3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/7 Support"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvService3Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Always here for you"
                        android:textSize="10.5sp"
                        android:textColor="#9AA1A9"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CTA Button -->
            <Button
                android:id="@+id/btnGetStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Let's Get Started  →"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:background="@drawable/bg_cta_white"
                android:textAllCaps="false"
                android:alpha="0" />

        </LinearLayout>
    </LinearLayout>

    <!-- Black Veil for Exit Transition -->
    <View
        android:id="@+id/veilView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:clickable="false" />

</FrameLayout>
