<?xml version="1.0" encoding="utf-8"?>
<!-- Pagination component for cart items -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/paginationContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <!-- Page indicator text: "Page 1 of 3" -->
    <TextView
        android:id="@+id/tvPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:text="Page 1 of 1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <!-- Navigation controls container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous arrow button -->
        <ImageButton
            android:id="@+id/btnPrevPage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_page_arrow"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Previous page"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:layout_marginEnd="12dp"
            android:enabled="false" />

        <!-- Page number buttons container -->
        <LinearLayout
            android:id="@+id/pageNumbersContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- Page number buttons will be added programmatically -->
        </LinearLayout>

        <!-- Next arrow button -->
        <ImageButton
            android:id="@+id/btnNextPage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_page_arrow"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Next page"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>
