<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- SMOKE BACKGROUND: Bottom-most layer with Screen blend mode, no tint, intensity 1.0 -->
    <com.hookahdrop.app.view.SmokeBackgroundView
        android:id="@+id/smokeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Breathing radial glow behind logo -->
    <View
        android:id="@+id/radialGlow"
        android:layout_width="600dp"
        android:layout_height="800dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_splash_radial_glow"
        android:alpha="0" />

    <!-- Ember particles container -->
    <FrameLayout
        android:id="@+id/emberContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <!-- Logo container (centered at ~42% height) -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:alpha="0">

        <!-- Rotating gradient arc (will be added programmatically) -->
        <FrameLayout
            android:id="@+id/arcContainer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center" />

        <!-- Amber ring -->
        <ImageView
            android:id="@+id/logoRing"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/glow_ring"
            android:alpha="1" />

        <!-- Logo (existing asset) -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_hookah_neon"
            android:scaleType="fitCenter"
            android:contentDescription="HookahDrop" />

    </FrameLayout>

    <!-- Status text (under logo) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="280dp"
        android:text="Lighting the coals…"
        android:textColor="#8FA3B8"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.15"
        android:alpha="0" />

    <!-- Loading bar area at bottom (EXISTING position preserved) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">

        <!-- Track -->
        <View
            android:id="@+id/loadingTrack"
            android:layout_width="280dp"
            android:layout_height="3dp"
            android:background="@drawable/loading_track_new"
            android:alpha="0" />

        <!-- Fill with glow -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Glow layer -->
            <View
                android:id="@+id/loadingGlow"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="-4.5dp"
                android:background="@drawable/loading_fill_new"
                android:alpha="0.4" />

            <!-- Solid fill -->
            <View
                android:id="@+id/loadingBar"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@drawable/loading_fill_new" />

            <!-- Leading edge dot -->
            <View
                android:id="@+id/loadingDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="-1.5dp"
                android:layout_marginStart="-3dp"
                android:background="@drawable/ember_particle"
                android:alpha="0" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
