<?xml version="1.0" encoding="utf-8"?>
<!--
  Favorite product card — horizontal layout matching the reference screenshot.
  LEFT  : square image panel (dark bg) with cyan heart button overlaid top-left
  RIGHT : name, category, stars row, cyan price, availability dot + label, View + Rent buttons
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/favItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginBottom="12dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0D0F14"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="130dp"
            android:orientation="horizontal">

            <!-- ── LEFT: image panel ── -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="#12141A">

                <ImageView
                    android:id="@+id/imgFavProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Product image"
                    android:minHeight="130dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <!-- Cyan heart button — top-left over image -->
                <ImageButton
                    android:id="@+id/btnHeart"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_fav_heart_btn"
                    android:contentDescription="Remove from favorites"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_favorite_filled_cyan" />

            </FrameLayout>

            <!-- ── RIGHT: product info ── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Product name -->
                <TextView
                    android:id="@+id/tvFavName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Category / type label -->
                <TextView
                    android:id="@+id/tvFavCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Rating row: stars + number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 5 star images rendered programmatically via tvRatingStars -->
                    <TextView
                        android:id="@+id/tvRatingStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFD700"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFavRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/tvFavPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/accent_cyan"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Availability row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotAvailability"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ic_dot_available" />

                    <TextView
                        android:id="@+id/tvAvailability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- View + Rent buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnView"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_view_btn"
                        android:stateListAnimator="@null"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnRent"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rent_btn"
                        android:stateListAnimator="@null"
                        android:text="Rent"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
