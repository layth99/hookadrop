<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_screen" android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="24dp" android:paddingBottom="48dp">

        <!-- Back -->
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/bg_back_button"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" android:padding="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="48dp"/>

        <!-- Lock icon -->
        <FrameLayout android:id="@+id/iconWrap"
            android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/bg_menu_icon"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center" android:src="@drawable/ic_lock"
                android:contentDescription="Lock"/>
        </FrameLayout>

        <!-- Title -->
        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Change Password"
            android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iconWrap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Step indicator -->
        <TextView android:id="@+id/tvStep"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Step 1 of 2 — Verify current password"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- ── STEP A: Current password ── -->
        <LinearLayout android:id="@+id/stepA"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvStep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Current Password" android:textColor="@color/white"
                android:textSize="13sp" android:layout_marginBottom="6dp"/>

            <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:hint="••••••••" android:textColorHint="@color/hint_color"
                    android:textColor="@color/white" android:inputType="textPassword"
                    android:paddingHorizontal="18dp" android:paddingEnd="52dp"
                    android:textSize="15sp"/>
                <ImageView android:id="@+id/ivEyeA"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_off" android:contentDescription="Show"/>
            </FrameLayout>

            <TextView android:id="@+id/tvErrorA"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#EF4444" android:textSize="12sp"
                android:visibility="gone" android:layout_marginTop="6dp"/>

            <Button android:id="@+id/btnContinue"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Continue" android:textSize="15sp"
                android:textColor="@color/white" android:background="@drawable/bg_button_gold"
                android:textAllCaps="false" android:layout_marginTop="24dp"/>
        </LinearLayout>

        <!-- ── STEP B: New password (hidden initially) ── -->
        <LinearLayout android:id="@+id/stepB"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvStep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="New Password" android:textColor="@color/white"
                android:textSize="13sp" android:layout_marginBottom="6dp"/>

            <FrameLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginBottom="6dp">
                <EditText android:id="@+id/etNewPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:hint="Min. 8 characters" android:textColorHint="@color/hint_color"
                    android:textColor="@color/white" android:inputType="textPassword"
                    android:paddingHorizontal="18dp" android:paddingEnd="52dp"
                    android:textSize="15sp"/>
                <ImageView android:id="@+id/ivEyeB1"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_off" android:contentDescription="Show"/>
            </FrameLayout>

            <!-- Password strength bar -->
            <ProgressBar android:id="@+id/strengthBar"
                android:layout_width="match_parent" android:layout_height="4dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="4" android:progress="0"
                android:progressTint="@color/accent_cyan"
                android:progressBackgroundTint="@color/card_border"
                android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvStrength"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Confirm New Password" android:textColor="@color/white"
                android:textSize="13sp" android:layout_marginBottom="6dp"/>

            <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                <EditText android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:hint="Repeat new password" android:textColorHint="@color/hint_color"
                    android:textColor="@color/white" android:inputType="textPassword"
                    android:paddingHorizontal="18dp" android:paddingEnd="52dp"
                    android:textSize="15sp"/>
                <ImageView android:id="@+id/ivEyeB2"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_off" android:contentDescription="Show"/>
            </FrameLayout>

            <TextView android:id="@+id/tvErrorB"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#EF4444" android:textSize="12sp"
                android:visibility="gone" android:layout_marginTop="6dp"/>

            <Button android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Save Password" android:textSize="15sp"
                android:textColor="@color/white" android:background="@drawable/bg_button_gold"
                android:textAllCaps="false" android:layout_marginTop="24dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
