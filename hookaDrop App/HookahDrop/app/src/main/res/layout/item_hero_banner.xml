<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Photo -->
    <ImageView
        android:id="@+id/imgHero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_hero_card"
        android:clipToOutline="true"
        android:contentDescription="Banner" />

    <!-- Dark overlay — covers full image so text is always readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Left-side gradient for extra depth under text -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <!-- Text + button content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginStart="20dp">

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="1" android:shadowDy="1" android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvHeroSubtitle"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnShopNow"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Shop Now"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:background="@drawable/bg_button_gold"
            android:textAllCaps="false"
            android:paddingHorizontal="18dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- 3 dot indicators at bottom center -->
    <LinearLayout
        android:id="@+id/dotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp" />

</FrameLayout>
