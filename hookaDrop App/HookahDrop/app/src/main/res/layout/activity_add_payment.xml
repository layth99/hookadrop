<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fitsSystemWindows="true">

    <!-- ── HEADER ────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_back_button"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Payment Method"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <!-- ── SCROLLABLE CONTENT ────────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- ── SELECT PAYMENT METHOD TITLE ──────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select payment method"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- ── PAYMENT METHOD SELECTOR ROW ──────────────────────────── -->
            <!--
                Using LinearLayout cards instead of RadioButtons with drawableTop
                because RadioButton + drawableTop has known layout issues on Android.
                Selection state is managed in code via setMethodSelected().
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Card -->
                <LinearLayout
                    android:id="@+id/cardMethodCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_payment_method_selector"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_credit_card"
                        android:contentDescription="Card"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Card"
                        android:textColor="@color/white"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- PayPal -->
                <LinearLayout
                    android:id="@+id/paypalMethodCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_payment_method_selector"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P"
                        android:textColor="#009CDE"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="PayPal"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- More (coming soon) -->
                <LinearLayout
                    android:id="@+id/moreMethodCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_payment_method_selector"
                    android:alpha="0.4"
                    android:clickable="false"
                    android:focusable="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•••"
                        android:textColor="@color/hint_color"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="More"
                        android:textColor="@color/hint_color"
                        android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── PayPal unavailable notice (shown when PayPal selected) ─ -->
            <LinearLayout
                android:id="@+id/paypalNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Info"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PayPal integration requires backend configuration. Configure PAYPAL_CLIENT_ID in your server environment to enable this payment method."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>

            <!-- ── CARD FORM ─────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Card number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card number"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_card_input"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="•••• •••• •••• ••••"
                        android:textColorHint="@color/hint_color"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:paddingHorizontal="14dp"
                        android:inputType="number"
                        android:maxLength="19"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:letterSpacing="0.08"/>

                    <!-- Card brand logo -->
                    <ImageView
                        android:id="@+id/imgCardBrand"
                        android:layout_width="36dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Card brand"/>

                </FrameLayout>

                <!-- Card number error -->
                <TextView
                    android:id="@+id/tvCardNumberError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/input_border_error"
                    android:textSize="11sp"
                    android:visibility="gone"/>

                <!-- Cardholder name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardholder name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_card_input"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/etCardName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="JOHN DOE"
                        android:textColorHint="@color/hint_color"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:paddingHorizontal="14dp"
                        android:inputType="textPersonName|textCapCharacters"
                        android:imeOptions="actionNext"
                        android:singleLine="true"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvCardNameError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/input_border_error"
                    android:textSize="11sp"
                    android:visibility="gone"/>

                <!-- Expiry + CVV row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <!-- Expiry -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expiry date"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_card_input">

                            <EditText
                                android:id="@+id/etExpiry"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="MM/YY"
                                android:textColorHint="@color/hint_color"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:paddingHorizontal="14dp"
                                android:inputType="number"
                                android:maxLength="5"
                                android:imeOptions="actionNext"
                                android:singleLine="true"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvExpiryError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/input_border_error"
                            android:textSize="11sp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- CVV -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CVV"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_card_input">

                            <EditText
                                android:id="@+id/etCvv"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="•••"
                                android:textColorHint="@color/hint_color"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:paddingHorizontal="14dp"
                                android:inputType="numberPassword"
                                android:maxLength="4"
                                android:imeOptions="actionDone"
                                android:singleLine="true"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvCvvError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/input_border_error"
                            android:textSize="11sp"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Save this card toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Save this card"
                        android:textColor="@color/white"
                        android:textSize="15sp"/>

                    <Switch
                        android:id="@+id/switchSaveCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/accent_cyan"/>
                </LinearLayout>

                <!-- Security note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_lock"
                        android:alpha="0.5"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Secure"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secured by Stripe. Card data never touches our servers."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:alpha="0.8"/>
                </LinearLayout>

                <!-- Status message -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:visibility="gone"/>

                <!-- Submit button -->
                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Add Card"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_checkout_btn"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── PROCESSING OVERLAY ─────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/bg_card_dark_round">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/accent_cyan"/>

            <TextView
                android:id="@+id/tvProcessingMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Verifying card…"
                android:textColor="@color/white"
                android:textSize="14sp"/>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
