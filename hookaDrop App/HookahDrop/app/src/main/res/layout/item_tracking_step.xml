<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <!-- Vertical Line -->
    <View
        android:id="@+id/vLine"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignStart="@id/ivStepIcon"
        android:layout_marginStart="15dp"
        android:layout_marginTop="32dp"
        android:background="@color/input_border" />

    <!-- Icon Circle -->
    <ImageView
        android:id="@+id/ivStepIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:src="@drawable/ic_radio_button_checked"
        app:tint="@color/accent_cyan" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivStepIcon"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Placed"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your order has been received"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvStepTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, 10:30 AM"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="visible" />
    </LinearLayout>
</RelativeLayout>
