<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fitsSystemWindows="true">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ── HEADER ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="48dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/imgHeaderLogo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_hookah_neon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guest"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        android:contentDescription="Notifications" />

                    <View
                        android:id="@+id/notificationDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_badge" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── HERO BANNER ─────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/heroBannerPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Dot indicators -->
                <LinearLayout
                    android:id="@+id/bannerIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:visibility="visible" />
            </FrameLayout>

            <!-- ── BENEFITS ROW ────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/benefitsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="14dp" />

            <!-- ── CATEGORIES HEADER ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categories"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── CATEGORIES GRID (RecyclerView) ─────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ── VIEW ALL CATEGORIES BUTTON ─────────────────────── -->
            <Button
                android:id="@+id/btnViewAllCategories"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_view_all_button"
                android:text="View All Categories"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:drawableEnd="@drawable/ic_chevron_right_white"
                android:drawablePadding="8dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:paddingHorizontal="20dp" />

            <!-- ── POPULAR PRODUCTS HEADER ─────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular Products"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── PRODUCTS GRID (RecyclerView) ───────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ── VIEW ALL PRODUCTS BUTTON ───────────────────────── -->
            <Button
                android:id="@+id/btnViewAllProducts"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_view_all_button"
                android:text="View All Products"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:drawableEnd="@drawable/ic_chevron_right_white"
                android:drawablePadding="8dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:paddingHorizontal="20dp" />

            <!-- ── PROMO BANNER ────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_hero_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgPromoBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hookah_photo_3"
                    android:scaleType="centerCrop"
                    android:alpha="0.3"
                    android:contentDescription="Promo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekend Sale"
                            android:textColor="@color/gold"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Up to 25% off all accessories"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPromoShop"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Shop"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button_gold"
                        android:textAllCaps="false"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM NAV pinned at bottom ────────────────────────────── -->
    <include
        layout="@layout/layout_bottom_nav"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
