<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_hookah_neon"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="36dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE ACCOUNT"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join HookaDrop today"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- ── USERNAME ── -->
        <TextView android:id="@+id/tvName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Username" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <EditText android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="John Doe" android:textColorHint="@color/hint_color"
            android:textColor="@color/white" android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="18dp" android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- ── EMAIL ── -->
        <TextView android:id="@+id/tvEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Email" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/etName"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"/>

        <EditText android:id="@+id/etEmail"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="example@gmail.com" android:textColorHint="@color/hint_color"
            android:textColor="@color/white" android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp" android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- ── PHONE ── -->
        <TextView android:id="@+id/tvPhone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Phone Number" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/etEmail"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"/>

        <EditText android:id="@+id/etPhone"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="+1 234 567 8900" android:textColorHint="@color/hint_color"
            android:textColor="@color/white" android:inputType="phone"
            android:paddingHorizontal="18dp" android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- ── AGE ── -->
        <TextView android:id="@+id/tvAge"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Age" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/etPhone"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"/>

        <EditText android:id="@+id/etAge"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="Must be 20 or older" android:textColorHint="@color/hint_color"
            android:textColor="@color/white" android:inputType="number"
            android:paddingHorizontal="18dp" android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvAge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Age error -->
        <TextView android:id="@+id/tvAgeError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="You must be 20 years old or older to create a HookaDrop account."
            android:textColor="#EF4444" android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/etAge"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- ── PASSWORD ── -->
        <TextView android:id="@+id/tvPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Password" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvAgeError"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"/>

        <FrameLayout android:id="@+id/passwordContainer"
            android:layout_width="match_parent" android:layout_height="52dp"
            app:layout_constraintTop_toBottomOf="@id/tvPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp">

            <EditText android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_input_field"
                android:hint="••••••••" android:textColorHint="@color/hint_color"
                android:textColor="@color/white" android:inputType="textPassword"
                android:paddingHorizontal="18dp" android:paddingEnd="52dp"
                android:textSize="15sp"/>

            <ImageView android:id="@+id/ivEyeToggle"
                android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_eye_off"
                android:contentDescription="Toggle password"/>
        </FrameLayout>

        <!-- ── CONFIRM PASSWORD ── -->
        <TextView android:id="@+id/tvConfirmPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Confirm Password" android:textColor="@color/white" android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/passwordContainer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="14dp"/>

        <FrameLayout android:id="@+id/confirmPasswordContainer"
            android:layout_width="match_parent" android:layout_height="52dp"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp">

            <EditText android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_input_field"
                android:hint="••••••••" android:textColorHint="@color/hint_color"
                android:textColor="@color/white" android:inputType="textPassword"
                android:paddingHorizontal="18dp" android:paddingEnd="52dp"
                android:textSize="15sp"/>

            <ImageView android:id="@+id/ivEyeToggle2"
                android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_eye_off"
                android:contentDescription="Toggle confirm password"/>
        </FrameLayout>

        <!-- Password mismatch error -->
        <TextView android:id="@+id/tvPasswordError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Passwords do not match."
            android:textColor="#EF4444" android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/confirmPasswordContainer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- ── SIGN UP BUTTON ── -->
        <Button android:id="@+id/btnSignUp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="16sp" android:textColor="@color/white"
            android:background="@drawable/bg_button_gold"
            android:textAllCaps="false"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- ── SIGN IN LINK ── -->
        <TextView android:id="@+id/tvSignIn"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/btnSignUp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:textSize="14sp" android:textColor="@color/text_muted"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
