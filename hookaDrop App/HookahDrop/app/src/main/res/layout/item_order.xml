<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_profile_card"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:clickable="true" android:focusable="true">

    <!-- Row 1: Order ID + status -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/tvOrderId"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent_cyan" android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="10dp" android:paddingVertical="3dp"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_status_badge"/>
    </LinearLayout>

    <!-- Row 2: Items + total -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/tvOrderItems"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>

            <TextView android:id="@+id/tvPaymentMethod"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/hint_color" android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">

            <TextView android:id="@+id/tvOrderTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/gold_neon" android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/tvPaidStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Date + Track Button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView android:id="@+id/tvOrderDate"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/hint_color" android:textSize="11sp"/>

        <Button android:id="@+id/btnTrackOrder"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="Track Order"
            android:textSize="11sp"
            android:textColor="@color/accent_cyan"
            android:background="@drawable/bg_button_outlined"
            android:paddingHorizontal="12dp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"/>

        <ImageView android:layout_width="14dp" android:layout_height="14dp"
            android:src="@drawable/ic_arrow_right"
            android:alpha="0.4"
            android:contentDescription="Open"/>
    </LinearLayout>
</LinearLayout>
