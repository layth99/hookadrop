<?xml version="1.0" encoding="utf-8"?>
<!-- HookaDrop Premium Nav Bar background — dark, rounded top corners, subtle top border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top border glow line (very subtle) -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1400BFFF"/>
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
        </shape>
    </item>

    <!-- Main background -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0C0E13"/>
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
        </shape>
    </item>

</layer-list>
