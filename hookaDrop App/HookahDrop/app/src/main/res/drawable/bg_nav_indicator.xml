<?xml version="1.0" encoding="utf-8"?>
<!-- Sliding active indicator — pill shape, cyan glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer soft glow (blur effect via expanded layer) -->
    <item
        android:left="-4dp"
        android:right="-4dp"
        android:top="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1500BFFF"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <!-- Core indicator pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00BFFF"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>

</layer-list>
