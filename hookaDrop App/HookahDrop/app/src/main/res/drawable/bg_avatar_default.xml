<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer cyan ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A00BCD4"/>
            <stroke android:width="2dp" android:color="#00BCD4"/>
        </shape>
    </item>
    <!-- Inner dark circle -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#1E2A32"/>
        </shape>
    </item>
    <!-- Silhouette icon centered -->
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="10dp">
        <bitmap
            android:src="@drawable/ic_profile"
            android:gravity="center"
            android:tint="#4D00BCD4"/>
    </item>
</layer-list>
