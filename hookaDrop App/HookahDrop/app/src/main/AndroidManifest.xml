<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".HookahDropApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HookahDrop">

        <!-- Google Maps API key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key"/>

        <!-- ── Auth flow ───────────────────────────────────────────────── -->
        <activity android:name=".SplashActivity" android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".OnboardingActivity" android:exported="false"
            android:screenOrientation="portrait"/>

        <activity android:name=".DebugTestActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop"/>

        <activity android:name=".SignInActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".SignUpActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ForgotPasswordActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".VerifyCodeActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".EmailVerifyActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".NewPasswordActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <!-- ── Main app ────────────────────────────────────────────────── -->
        <activity android:name=".FavoritesActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".CartActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".HomeActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".PopularProductsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".CategoryProductsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".CategoriesActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".ProductDetailActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Transparent"/>

        <!-- ── Profile system ──────────────────────────────────────────── -->
        <activity android:name=".ProfileActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".EditProfileActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".OrdersActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".OrderDetailActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".OrderTrackingActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".PromoCodesActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".AddressesActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".AddMapActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".PaymentMethodsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".AddPaymentActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".SettingsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".ChangePasswordActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".LanguageActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".TermsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".PrivacyPolicyActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <activity android:name=".HelpSupportActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <!-- ── Notification system ─────────────────────────────────── -->
        <activity android:name=".NotificationsActivity" android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HookahDrop.Main"/>

        <service
            android:name=".HookahDropFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

    </application>

</manifest>
