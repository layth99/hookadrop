<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.xml and add your real API keys
  DO NOT commit secrets.xml to version control!
  Add secrets.xml to .gitignore
-->
<resources>
    <!--
      Google Maps API Key
      Get it from: https://console.cloud.google.com/
      Enable these APIs: Maps SDK for Android, Places API, Geocoding API
    -->
    <string name="google_maps_key" translatable="false">YOUR_GOOGLE_MAPS_API_KEY</string>

    <!--
      Stripe Publishable Key (safe to use in client)
      Get it from: https://dashboard.stripe.com/apikeys
      Use pk_test_... for testing, pk_live_... for production
    -->
    <string name="stripe_publishable_key" translatable="false">YOUR_STRIPE_PUBLISHABLE_KEY</string>
</resources>
