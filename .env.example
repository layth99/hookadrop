PORT=8000
MONGO_DB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hookadrop

JWT_SECRET=your_jwt_secret_min_32_chars
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email (nodemailer / Gmail SMTP) ───────────────────────────────────────────
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# Enable 2-Factor Authentication first, then create an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=HookaDrop
EMAIL_FROM=your_gmail@gmail.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Production only ───────────────────────────────────────────────────────────
# FRONTEND_URL=https://your-app.netlify.app
