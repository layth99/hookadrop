PORT=8000
MONGO_DB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hookadrop

JWT_SECRET=your_jwt_secret_min_32_chars
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email (Resend HTTPS API — works on Render Free) ──────────────────────────
# Sign up free at https://resend.com → API Keys → Create API Key
# Free tier: 3 000 emails/month, 100/day
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address shown to recipients.
# Option A (works immediately, free): HookaDrop <onboarding@resend.dev>
# Option B (branded):                 HookaDrop <hookadrop@gmail.com>
#   → Add hookadrop@gmail.com as a Sender Signature in Resend dashboard
#     (Resend sends a confirmation link to that Gmail address — one click).
EMAIL_FROM=HookaDrop <onboarding@resend.dev>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Production only ───────────────────────────────────────────────────────────
# FRONTEND_URL=https://your-app.netlify.app
